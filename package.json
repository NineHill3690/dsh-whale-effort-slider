{
  "name": "dsh-whale-effort-slider",
  "version": "1.3.0",
  "description": "Whale reasoning-effort slider for DeepSeek Harness: one trigger, one popover, an effort rail (stops come from the model) with a whale knob, and a two-level provider/model drill-down. Forked from ABING1111/dsh-codex-model-effort-selector (MIT), evolved independently since v1.3.0.",
  "type": "module",
  "license": "MIT",
  "icon": "./icon.svg",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "codex",
    "reasoning-effort",
    "model-selector",
    "dsh-plugin",
    "deepseek"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NineHill3690/dsh-whale-effort-slider.git"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "icon.svg",
    "locale/*.json",
    "docs/*.md",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "peerDependencies": {
    "@deepseek-ai/dsh": ">=0.2.0-rc.2 <0.3.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-model-selection",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "homepage": "https://github.com/NineHill3690/dsh-whale-effort-slider#readme",
  "engines": {
    "dsh": ">=0.2.0-rc.2 <0.3.0"
  }
}
